	"scripts": {
		"clean": "react-native-clean-project",
		"cleanCache": "cd android && ./gradlew cleanBuildCache",
		"cleanAndroid": "cd android && ./gradlew clean",
		"clear:rn-cache": "react-native start --reset-cache",
		"clear-watchman": "watchman watch-del '.' && watchman watch-project '.'",
		"pod:install": "cd ios && pod install --verbose",
		"pod:repo-update": "cd ios && pod install --repo-update  --ansi --verbose",
		"build:apk": "cd android && ./gradlew assembleRelease",
		"lint": "eslint --ext .ts --ext .tsx ./src --fix",
		"start": "expo start --dev-client",
		"expo:start": "expo start --dev-client",
		"tunnel": "expo start --tunnel",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"ipad": "expo run:ios --device 'iPad Pro (12.9-inch) (6th generation)'",
		"android:release": "expo run:android --variant release",
		"ios:release": "expo run:ios --variant release",
		"web": "expo start --web",
		"postinstall": "patch-package && husky install",
		"prepare": "husky install",
		"rn:android": "react-native run-android",
		"rn:ios": "react-native run-ios --simulator 'iPhone 15 Pro Max'",
		"expo:android": "expo start --android",
		"expo:ios": "expo start --ios",
		"eas:configure": "eas build:configure",
		"build": "eas build",
		"bundle": "cd android && ./gradlew bundleRelease",
		"add": "expo install",
		"clear-pods": "cd ios && rm -rf ~/Library/Caches/CocoaPods && rm -rf Pods  && pod deintegrate && pod setup && pod install --verbose",
		"publish:ios": "eas build:configure  --platform ios && eas build --platform ios && eas submit --platform ios",
		"build:android": "eas build:configure  --platform android && eas build --platform android"
	},
